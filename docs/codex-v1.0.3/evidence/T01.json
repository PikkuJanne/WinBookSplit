  "pester_wrapper_sanitized_source": "param([switch]$Desired, [Parameter(Mandatory=$true)][string]$ReportPath)\nSet-StrictMode -Version Latest\n$ErrorActionPreference='Stop'\n$repository='<WORKSPACE>'\n$work='<EXTERNAL_T01>'\n$oldTemp=$env:TEMP; $oldTmp=$env:TMP\ntry {\n    $env:TEMP=$work; $env:TMP=$work\n    Import-Module '<EXTERNAL_TOOLS>\\Pester\\6.2.0\\Pester.psd1' -Force -ErrorAction Stop\n    $config=New-PesterConfiguration\n    $config.Run.Container=@(New-PesterContainer -Path (Join-Path $repository 'tests\\powershell\\StoreDiscovery.Tests.ps1') -Data @{RepositoryRoot=$repository;WorkRoot=$work;DesiredStoreBehavior=[bool]$Desired})\n    $config.Run.PassThru=$true; $config.Run.Exit=$false\n    $config.Filter.Tag=if($Desired){@('T01-Store-Desired')}else{@('T01-Store')}\n    $config.Output.Verbosity='Detailed'\n    $result=Invoke-Pester -Configuration $config\n    $report=[ordered]@{schema_version=1;layer='SYNTHETIC T01 behavioral reproduction, not native Store acceptance';host=$PSVersionTable.PSVersion.ToString();desired=[bool]$Desired;result=$result.Result.ToString();total=$result.TotalCount;passed=$result.PassedCount;failed=$result.FailedCount;skipped=$result.SkippedCount;not_run=$result.NotRunCount;failed_containers=$result.FailedContainersCount;test_sha256=(Get-FileHash -LiteralPath (Join-Path $repository 'tests\\powershell\\StoreDiscovery.Tests.ps1') -Algorithm SHA256).Hash.ToLowerInvariant();failed_cases=@($result.Failed | ForEach-Object {@{name=$_.ExpandedPath;errors=@($_.ErrorRecord | ForEach-Object {$_.Exception.Message})}});container_errors=@($result.FailedContainers | ForEach-Object {@($_.ErrorRecord | ForEach-Object {$_.Exception.Message})})}\n    $json=$report|ConvertTo-Json -Depth 8\n    $stream=[IO.File]::Open($ReportPath,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)\n    try {$writer=New-Object IO.StreamWriter($stream,(New-Object Text.UTF8Encoding($false))); try {$writer.Write($json)}finally{$writer.Dispose()}}finally{$stream.Dispose()}\n    if($result.FailedCount -gt 0 -or $result.FailedContainersCount -gt 0){exit 1}\n    exit 0\n}finally{$env:TEMP=$oldTemp;$env:TMP=$oldTmp}\n",
