    "principal_release_relevant": {
      "advisory": "GHSA-x3rh-gjgm-fmqc",
      "finding": "Opening cross-reference-stream PDFs reaches initialization parsing before application preflight. Candidate6.21.1 lacks the new document-wide cross-reference entry budget. Official merged fix describes highly compressible streams and chained /Prev entries exceeding existing stream bounds.",
      "application_call_path": [
        {
          "path": "engine/winbooksplit_conversion.py",
          "line": 217,
          "finding": "PolicyPdfReader calls superclass constructor with bounded input snapshot and root recovery4096; default strict=False."
        },
        {
          "path": "engine/winbooksplit_conversion.py",
          "line": 218,
          "finding": "Application PDF structural preflight occurs after superclass initialization."
        },
        {
          "path": "engine/winbooksplit_engine.py",
          "line": 114,
          "finding": "Production PdfReader is bound to shared PolicyPdfReader."
        },
        {
          "path": "engine/winbooksplit_engine.py",
          "line": 893,
          "finding": "Preparation calls shared PdfReader before page operations."
        },
        {
          "path": "engine/winbooksplit_engine.py",
          "line": 1684,
          "finding": "Main input route calls shared PdfReader."
        },
        {
          "path": "engine/WinBookSplit.Process.ps1",
          "line": 435,
          "finding": "Engine job limits.Basic.Flags=0x2000 (kill on close); fields for process/job memory exist but no heap-cap flags/value are set by this configuration."
        }
      ],
      "upstream_call_path": "pypdf6.21.1 __init__:154 -> _initialize_stream:179 -> read:738 -> _read_xref_tables_and_trailers -> _read_pdf15_xref_stream:1138.",
      "official_fix": {
        "html_url": "https://github.com/py-pdf/pypdf/pull/4269",
        "merged": true,
        "merged_at": "2026-10-27T11:18:48Z",
        "title": "SEC: Limit total number of cross-reference stream entries"
      },
      "resource_limits": "Bounded source snapshot, stream bounds, deadlines and kill-on-close do not provide the new document-wide xref entry budget or a process heap cap.",
      "disposition": "Hold another candidate-F owner acceptance recommendation while current security release disposition is unresolved. This audit selects no dependency and makes no repair."
    },
